{
  "name": "ag-ui-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "content:build": "node scripts/build-content.mjs",
    "content:validate": "node scripts/build-content.mjs --check",
    "dev": "npm run content:build && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "node scripts/clean-build.mjs && npm run content:build && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run content:build && node --test tests/content.test.mjs tests/decision.test.mjs tests/lab.test.mjs tests/policies.test.mjs",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "check:sources": "node scripts/ecosystem-watch.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "security:audit": "npm audit --registry=https://registry.npmjs.org --audit-level=high",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "16.2.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "0.5.28",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.112.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "postcss": "8.5.20"
  },
  "type": "module"
}
